<style>
  .hero {
    display: flex; flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 22vh 3rem 48px;
    min-height: 78vh;
    position: relative;
    text-align: center;
    background: #F5F5F3;
