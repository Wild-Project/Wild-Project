  }
  /* ── CI als Gestaltungselement an der Seite ── */
  .hero::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0; width: 10px;
    z-index: 3;
    background: linear-gradient(180deg, #FC5000 0 25%, #050505 25% 50%, #00354F 50% 75%, #E4E4E4 75% 100%);
    transform: scaleY(0); transform-origin: top;
    animation: ciBar 1s cubic-bezier(.5,.1,.2,1) 1.9s forwards;
  }
  @keyframes ciBar { to { transform: scaleY(1); } }
  /* ── Brands × Friends: rotierender Stempel, beim Hover aktiv ── */
  .bf-badge {
    position: absolute;
    right: 96px; bottom: 60px;
    width: 92px; height: 92px;
    border-radius: 50%;
    display: block;
    z-index: 4;
    text-decoration: none;
    opacity: 0;
    animation: bfIn 0.9s cubic-bezier(.34,1.56,.64,1) 2.4s forwards;
  }
  .bf-badge::before {
    content: '';
    position: absolute; inset: 19px;
    border-radius: 50%;
    border: 1px solid rgba(252,80,0,0.35);
    background: rgba(252,80,0,0);
    transform: scale(0.92);
    transition: background 0.35s ease, transform 0.35s cubic-bezier(.34,1.56,.64,1), border-color 0.35s;
  }
  .bf-ring {
    position: absolute; inset: 0; width: 100%; height: 100%;
    animation: bfSpin 26s linear infinite;
    overflow: visible;
  }
  .bf-ring text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 500;
    fill: rgba(0,0,0,0.55);
    transition: fill 0.3s;
  }
  .bf-core {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Poppins', sans-serif; font-weight: 700;
    color: var(--orange);
  }
  .bf-x, .bf-go { position: absolute; transition: opacity 0.25s, transform 0.35s cubic-bezier(.34,1.56,.64,1); }
  .bf-x { font-size: 22px; line-height: 1; }
  .bf-go { font-size: 18px; line-height: 1; color: #FFFFFF; opacity: 0; transform: translate(-6px, 6px) scale(0.6); }
  /* Hover nur auf Geräten mit Maus – am Handy kein „hängender“ Hover-Zustand */
  @media (hover: hover) {
    .bf-badge:hover::before { background: var(--orange); border-color: var(--orange); transform: scale(1); }
    .bf-badge:hover .bf-ring text { fill: #1a1a1a; }
    .bf-badge:hover .bf-x { opacity: 0; transform: rotate(90deg) scale(0.5); }
    .bf-badge:hover .bf-go { opacity: 1; transform: none; }
  }
  /* Tastatur + Antippen am Handy: kurzes Feedback nur solange gedrückt */
  .bf-badge:focus-visible::before, .bf-badge:active::before { background: var(--orange); border-color: var(--orange); transform: scale(1); }
  .bf-badge:focus-visible .bf-x, .bf-badge:active .bf-x { opacity: 0; transform: rotate(90deg) scale(0.5); }
  .bf-badge:focus-visible .bf-go, .bf-badge:active .bf-go { opacity: 1; transform: none; }
  .bf-badge { -webkit-tap-highlight-color: transparent; }
  .bf-badge:focus-visible { outline: 2px solid rgba(252,80,0,0.55); outline-offset: 4px; }
  @keyframes bfSpin { to { transform: rotate(360deg); } }
  @keyframes bfIn { from { opacity: 0; transform: scale(0.6) rotate(-40deg); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
