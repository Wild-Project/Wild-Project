<script>
  // Titel-Morph: nach dem Intro wird aus WILD PROJECT → RENÉ WILD
  const title = document.querySelector<HTMLElement>('.hero-title');
  const rene = title?.querySelector<HTMLElement>('.hw-rene');
  const project = title?.querySelector<HTMLElement>('.hw-project');
  if (title && rene && project) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const morph = () => {
      const reneW = (rene.firstElementChild as HTMLElement).scrollWidth;
      project.style.width = project.scrollWidth + 'px';
      void project.offsetWidth;
      title.classList.add('is-morphed');
      rene.style.width = reneW + 'px';
      project.style.width = '0px';
      // danach wieder flexibel, damit Resize/Schriftwechsel sauber bleiben
      setTimeout(() => { rene.style.width = 'auto'; }, 1500);
    };
    if (reduced) {
      title.classList.add('is-instant');
      morph();
    } else {
      setTimeout(morph, 2900);
    }
  }

  // Zitat: tippt sich nach dem Intro einmal in Mono und bleibt dann stehen
  const profile = document.querySelector<HTMLElement>('.hero-profile');
  const quote = document.querySelector<HTMLElement>('.hero-quote');
  const qText = quote?.querySelector<HTMLElement>('.hq-text');
  if (profile && quote && qText) {
    let timer = 0; let hideTimer = 0;
    const lang = () => (document.querySelector<HTMLElement>('.hero-lang-btn.is-active')?.dataset.lang === 'en' ? 'en' : 'de');
    const show = () => {
      clearInterval(timer); clearTimeout(hideTimer);
      const full = (lang() === 'en' ? quote.dataset.en : quote.dataset.de) || '';
      quote.classList.remove('is-done'); quote.classList.add('is-on');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        qText.textContent = full; quote.classList.add('is-done'); return;
      }
      let i = 0; qText.textContent = '';
      timer = window.setInterval(() => {
        i += 1; qText.textContent = full.slice(0, i);
        if (i >= full.length) { clearInterval(timer); quote.classList.add('is-done'); }
      }, 32);
    };
    const hide = () => { clearInterval(timer); quote.classList.remove('is-on'); };
    // einmal nach dem Intro tippen, dann stehen lassen
    window.setTimeout(show, 3600);
    document.querySelectorAll<HTMLElement>('.hero-lang-btn').forEach((b) =>
      b.addEventListener('click', () => window.setTimeout(() => {
        const full = (lang() === 'en' ? quote.dataset.en : quote.dataset.de) || '';
        if (quote.classList.contains('is-done')) qText.textContent = full;
      }, 0)));
  }
</script>
