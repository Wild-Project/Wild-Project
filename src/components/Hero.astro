    position: absolute;
    top: -1px;
    left: -20%;
    width: 22%;
    height: 4px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255,170,100,0.95) 50%,
      transparent 100%);
    filter: blur(1.5px);
    animation: heroLineSweep 6.5s ease-in-out 3.4s infinite;
  }
  @keyframes heroLineExpand {
    0%   { width: 0;   opacity: 0; }
    100% { width: 72%; opacity: 1; }
  }
  @keyframes heroLineSweep {
    0%   { left: -22%; opacity: 0; }
