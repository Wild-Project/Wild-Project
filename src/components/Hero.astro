  }
  .hero h1 {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1.0;
    color: #1a1a1a;
    margin: 0;
    overflow: hidden;
  }
  .hero h1 .hero-word-wild,
  .hero h1 .hero-word-project {
