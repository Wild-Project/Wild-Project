<footer class="footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-logo-link" href="/" aria-label="Zur Startseite">
        <img src="/wp-logo.png" alt="" class="footer-logo" width="36" height="36" />
      </a>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="mailto:rene@wildproject.pro">rene@wildproject.pro</a>
      <a href="https://www.linkedin.com/in/ren%C3%A9-wild-95428b314" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="/kontakt">Kontakt</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>

    <div class="footer-places" aria-label="Standort">
      <span><b>Rosenheim</b> 47.8561°N · 12.1289°E</span>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© 2026 Wild Project</span>
    <span><span class="footer-br">[</span> No Cookies · No Tracking · No BS <span class="footer-br">]</span></span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 40px;
    padding: 0 3rem 28px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    color: rgba(255,255,255,0.6);
    background: linear-gradient(180deg, rgba(5,5,5,0) 0%, rgba(5,5,5,0.92) 40%);
  }
  .footer::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 40px;
    background: linear-gradient(90deg, transparent 0%, rgba(252,80,0,0.55) 50%, transparent 100%);
  }
  .footer a { color: rgba(255,255,255,0.72); text-decoration: none; transition: color 0.2s; }
  .footer a:hover, .footer a:focus-visible { color: var(--orange); outline: none; }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-brand { display: flex; align-items: center; gap: 16px; }
  .footer-logo { width: 36px; height: 36px; display: block; opacity: 0.9; transition: opacity 0.2s, transform 0.3s; }
  .footer-logo-link:hover .footer-logo { opacity: 1; transform: rotate(-6deg); }
  .footer-servus {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    line-height: 1;
    color: var(--orange);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    font-size: 11.5px;
    letter-spacing: 1.5px;
  }
  .footer-nav a { display: inline-flex; align-items: center; min-height: 32px; }
  .footer-nav a:not(:first-child) { text-transform: uppercase; }

  .footer-places {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-size: 10.5px;
    letter-spacing: 1.2px;
    color: rgba(255,255,255,0.45);
  }
  .footer-places b {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.75);
    margin-right: 8px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    max-width: 1200px;
    margin: 32px auto 0;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 10.5px;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.45);
  }
  .footer-bottom a { color: rgba(255,255,255,0.62); }
  .footer-dot, .footer-br { color: var(--orange); }
  .footer-dot { margin: 0 6px; }

  @media (max-width: 860px) {
    .footer { padding: 0 1.25rem 28px; }
    .footer-main { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 24px; }
    .footer-places { align-items: center; }
    .footer-nav { gap: 2px 18px; }
    .footer-nav a { min-height: 40px; }
    .footer-bottom { flex-direction: column; align-items: center; text-align: center; gap: 8px; }
  }
</style>
