<footer class="footer">
  <div class="ft-cta">
    <a href="mailto:rene@wildproject.pro" class="ft-eyebrow"><span class="ft-br">[</span> rene@wildproject.pro <span class="ft-br">]</span></a>

    <div class="ft-sign">
      <div class="ft-social">
        <a class="ft-icon" href="https://www.linkedin.com/in/ren%C3%A9-wild-95428b314" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a class="ft-icon" href="https://www.instagram.com/wildproject.pro/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="ft-bottom">
    <a class="ft-brand" href="/" aria-label="Zur Startseite" data-i18n-label="To the homepage">
      <img src="/wp-logo.png" alt="" width="28" height="28" />
      <span>© 2026 Wild Project</span>
    </a>
    <nav class="ft-legal" aria-label="Rechtliches">
      <a href="/impressum" data-i18n-en="Legal notice">Impressum</a>
      <a href="/datenschutz" data-i18n-en="Privacy">Datenschutz</a>
    </nav>
    <span class="ft-place">Rosenheim <span class="ft-dim">· 47.8561°N 12.1289°E</span></span>
    <span class="ft-badge"><span class="ft-br">[</span> No Cookies · Anonymous Stats · No BS <span class="ft-br">]</span></span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    margin-top: 40px;
    padding: 0 3rem 26px;
    background: #050505;
    color: rgba(255,255,255,0.6);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow: hidden;
  }
  .footer::before {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(252,80,0,0.6) 50%, transparent 100%);
  }
  /* zarter Glow hinter der Mail */
  .footer::after {
    content: '';
    position: absolute;
    left: 50%; top: 0;
    width: 900px; height: 420px;
    transform: translate(-50%, -40%);
    background: radial-gradient(closest-side, rgba(252,80,0,0.10), transparent 70%);
    pointer-events: none;
  }
  .footer a { color: inherit; text-decoration: none; }
  .ft-br { color: var(--orange); }

  /* ---------- CTA ---------- */
  .ft-cta {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 0 56px;
    text-align: center;
  }
  .ft-eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: none;
    width: fit-content;
    margin: 0 auto;
    color: rgba(255,255,255,0.55) !important;
    transition: color 0.2s;
  }
  .ft-eyebrow:hover, .ft-eyebrow:focus-visible { color: #F5F5F3 !important; outline: none; }

  .ft-sign {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }
  .ft-social { display: flex; gap: 10px; }
  .ft-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    border: 1px solid rgba(252,80,0,0.45);
    color: var(--orange) !important;
    transition: background 0.2s, border-color 0.2s;
  }
  .ft-icon svg { width: 20px; height: 20px; }
  .ft-icon:hover, .ft-icon:focus-visible { background: rgba(252,80,0,0.12); border-color: var(--orange); outline: none; }

  /* ---------- Fußzeile ---------- */
  .ft-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 10.5px;
    letter-spacing: 1.2px;
    color: rgba(255,255,255,0.45);
  }
  .ft-brand { display: inline-flex; align-items: center; gap: 12px; }
  .ft-brand img { width: 28px; height: 28px; opacity: 0.9; transition: transform 0.3s; }
  .ft-brand:hover img { transform: rotate(-6deg); }
  .ft-legal { display: flex; gap: 20px; }
  .ft-legal a { color: rgba(255,255,255,0.65); text-transform: uppercase; letter-spacing: 1.5px; min-height: 24px; display: inline-flex; align-items: center; transition: color 0.2s; }
  .ft-legal a:hover, .ft-legal a:focus-visible { color: var(--orange); outline: none; }
  .ft-place { text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255,255,255,0.6); }
  .ft-dim { color: rgba(255,255,255,0.35); text-transform: none; letter-spacing: 1px; }
  .ft-badge { margin-left: auto; }

  @media (max-width: 860px) {
    .footer { padding: 0 1.25rem 24px; }
    .ft-cta { padding: 48px 0 44px; }
    .ft-bottom { flex-direction: column; text-align: center; gap: 14px; }
    .ft-badge { margin-left: 0; }
    .ft-legal a { min-height: 40px; }
  }
</style>
