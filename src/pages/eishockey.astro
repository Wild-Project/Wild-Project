---
import TopicPage from '../components/TopicPage.astro';
---

<TopicPage
  active="eishockey"
  title="Eishockey — René Wild · Wild Project"
  heading="Eishockey"
  intro="Spieler, Trainer und Nachwuchsprogramme entwickeln. Seit über 30 Jahren im Eishockey, als Spieler, Trainer und heute als Sportlicher Leiter im Nachwuchs-Eishockey."
  description="René Wild im Eishockey: Sportlicher Leiter Nachwuchs und Head Coach U17 der Starbulls Rosenheim, Trainerstationen, Arbeitsweise, Coaches-CV und der Podcast Shift2Pro."
>
  <div slot="strip" class="tp-strip" aria-label="Fotos: René Wild als Coach">
    <div class="tp-strip-track">
      <img src="/images/eishockey/coach-eis-1.jpg" title="Foto: Lukas Kirsch" alt="René Wild auf dem Eis mit Schläger" width="734" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-whiteboard.jpg" title="Foto: Lukas Kirsch" alt="René Wild erklärt eine Übung am Taktikboard" width="717" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-bande.jpg" alt="René Wild coacht hinter der Bande" width="800" height="533" loading="lazy" />
      <img src="/images/eishockey/coach-schlaeger.jpg" title="Foto: Michael Pointvogel" alt="René Wild mit Schläger und Handschuhen" width="870" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-eis-2.jpg" title="Foto: Lukas Kirsch" alt="René Wild läuft mit dem Puck übers Eis" width="734" height="1100" loading="lazy" />
      <span class="tp-strip-dup" aria-hidden="true">
      <img src="/images/eishockey/coach-eis-1.jpg" title="Foto: Lukas Kirsch" alt="" width="734" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-whiteboard.jpg" title="Foto: Lukas Kirsch" alt="" width="717" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-bande.jpg" alt="" width="800" height="533" loading="lazy" />
      <img src="/images/eishockey/coach-schlaeger.jpg" title="Foto: Michael Pointvogel" alt="" width="870" height="1100" loading="lazy" />
      <img src="/images/eishockey/coach-eis-2.jpg" title="Foto: Lukas Kirsch" alt="" width="734" height="1100" loading="lazy" />
      </span>
    </div>
  </div>

  <section class="tp-section">
    <div class="tp-section-head">01 · Aktuell</div>
    <div class="tp-grid">
      <div class="tp-card">
        <span class="tp-card-label"><span>seit 05/2026</span><span class="tp-status">Starbulls Rosenheim</span></span>
        <h2 class="tp-card-title">Sportlicher Leiter × Head of Coaches</h2>
        <p class="tp-card-text">Nachwuchs U7 bis U20</p>
      </div>
      <div class="tp-card">
        <span class="tp-card-label"><span>seit 05/2023</span><span class="tp-status">Starbulls Rosenheim</span></span>
        <h2 class="tp-card-title">U17 Head Coach &amp; Development Coach</h2>
        <p class="tp-card-text">U17 Division 1</p>
      </div>
    </div>
  </section>

  <section class="tp-section">
    <div class="tp-section-head">02 · Stationen</div>
    <ul class="tp-list">
      <li><span class="tp-when">seit 05/2024</span><span><strong>Development Coach</strong> · Dubé Skills</span></li>
      <li><span class="tp-when">08/2024</span><span><strong>Development Coach</strong> · DEL2 Perspektive Camp</span></li>
      <li><span class="tp-when">2022/23</span><span><strong>Head Coach U15 Nationalteam</strong> · Österreichischer Eishockeyverband</span></li>
      <li><span class="tp-when">2021 – 2023</span><span><strong>Head Coach U15</strong> · EC KAC · Meister Österreich U15 und IHL U15 2022/23</span></li>
      <li><span class="tp-when">2019 – 2021</span><span><strong>Director of Player Development &amp; Marketing</strong> · EC Spittal · Konzept „Junior Hornets“ U8 bis U12</span></li>
      <li><span class="tp-when">2018 – 2019</span><span><strong>Team Manager</strong> · EC VSV Pro Team</span></li>
      <li><span class="tp-when">2017 – 2018</span><span><strong>Head Coach Senioren</strong> · ECSV Spittal</span></li>
      <li><span class="tp-when">1999 – 2007</span><span><strong>Spieler</strong> · EC VSV, EC Dornbirn · Meister Österreich 2001/02 · Gold U20-WM Div. B, U18-WM Div. C</span></li>
    </ul>
  </section>

  <section class="tp-section">
    <div class="tp-section-head">03 · Arbeitsweise</div>
    <ul class="tp-bullets">
      <li>Wissen vermitteln, on- und off-ice</li>
      <li>Life Skills: Arbeitsmoral, Regeneration, Ernährung</li>
      <li>Werte verankern: Respekt, Teamgeist, Selbstverantwortung</li>
      <li>Charakter entwickeln: Einsatz, Wettkampfgeist, Siegeswille</li>
      <li>Videoanalyse für Spieler- und Teamentwicklung</li>
    </ul>
  </section>

  <section class="tp-section">
    <div class="tp-section-head">04 · Coaches-CV</div>
    <div class="tp-btns">
      <a class="tp-btn" href="/downloads/coaches-cv-rene-wild-de.pdf" download hreflang="de" type="application/pdf"><span>[ Coaches-CV · Deutsch ]</span><span>↓ PDF</span></a>
      <a class="tp-btn" href="/downloads/coach-cv-rene-wild-en.pdf" download hreflang="en" type="application/pdf"><span>[ Coach CV · English ]</span><span>↓ PDF</span></a>
    </div>
  </section>

  <section class="tp-section">
    <div class="tp-section-head">05 · Podcast</div>
    <a class="tp-card" href="https://www.shift2pro.com" target="_blank" rel="noopener">
      <span class="tp-card-label"><span>Shift2Pro</span><span class="tp-status">shift2pro.com →</span></span>
      <img src="/brand-assets/Logografie-02-white.png" alt="Shift2Pro — Eishockey · Development · Podcast" width="963" height="336" style="width: 220px; height: auto; margin: 6px 0;" />
      <p class="tp-card-text">Eishockey-Entwicklung neu gedacht — von der Laufschule bis zum Profi. Gespräche mit Menschen, die etwas bewegen und weitergeben wollen.</p>
    </a>
  </section>
</TopicPage>
