---
import TopicPage from '../components/TopicPage.astro';
---

<TopicPage
  active="lifestyle"
  title="Lifestyle — René Wild · Wild Project"
  heading="Lifestyle"
  intro="Design, Mode, Tech und Fotografie."
  description="Lifestyle bei Wild Project: Design, Mode, Tech und Fotografie."
>
  <section class="tp-section">
    <div class="tp-section-head">Bereiche</div>
    <div class="tp-grid">
      <div class="tp-card">
        <span class="tp-card-label"><span>[ 01 ]</span><span class="tp-status">Inhalte folgen</span></span>
        <h2 class="tp-card-title">Design</h2>
      </div>
      <div class="tp-card">
        <span class="tp-card-label"><span>[ 02 ]</span><span class="tp-status">Inhalte folgen</span></span>
        <h2 class="tp-card-title">Mode</h2>
      </div>
      <div class="tp-card">
        <span class="tp-card-label"><span>[ 03 ]</span><span class="tp-status">Inhalte folgen</span></span>
        <h2 class="tp-card-title">Tech</h2>
      </div>
      <a class="tp-card" href="https://unsplash.com/de/@wild_projects" target="_blank" rel="noopener">
        <span class="tp-card-label"><span>[ 04 ]</span><span class="tp-status">Unsplash →</span></span>
        <h2 class="tp-card-title">Fotografie</h2>
        <p class="tp-card-text">Meine Fotos auf Unsplash.</p>
      </a>
    </div>
  </section>
</TopicPage>
